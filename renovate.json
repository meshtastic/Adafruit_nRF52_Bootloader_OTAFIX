{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    ":semanticCommitTypeAll(chore)",
    ":ignoreModulesAndTests",
    ":noUnscheduledUpdates",
    "schedule:daily",
    "group:recommended",
    "replacements:all",
    "workarounds:all",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": ["master"],
  "git-submodules": {
    "enabled": true
  },
  "labels": ["dependencies"]
}
